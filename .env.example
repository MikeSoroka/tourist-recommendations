# Copy to .env and fill in. .env is gitignored; never commit real credentials.
DB_NAME=tourist_recommendations
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=tourist_app

REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_ENABLED=1

# Wikipedia scraping: workers is per process, and the MPI jobs run one process
# per rank, so the total request rate is HTTP_RATE_LIMIT_PER_SECOND x ranks.
HTTP_MAX_WORKERS=8
HTTP_RATE_LIMIT_PER_SECOND=10
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# Scheduled sync: how often to poll Wikipedia and drain the event stream
DETECT_INTERVAL_SECONDS=3600
CONSUME_INTERVAL_SECONDS=60
STREAM_NAME=wiki:changes
STREAM_GROUP=refresh

API_DEFAULT_PAGE_SIZE=50
API_MAX_PAGE_SIZE=200

# Optional: defaults to <project root>/data/images
# IMAGES_DIR=

# Ports published by docker compose
WEB_PORT=8000
DB_PORT_PUBLISHED=5432
REDIS_PORT_PUBLISHED=6379

# Set to 1 only for local development
FLASK_DEBUG=0
